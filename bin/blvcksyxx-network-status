#!/usr/bin/env bash
set -u
iface="$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i=="dev") {print $(i+1); exit}}')"
addr=""
connection=""
if [[ -n "$iface" ]]; then
    addr="$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')"
    if command -v nmcli >/dev/null 2>&1; then
        connection="$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | awk -F: -v d="$iface" '$2==d {print $1; exit}')"
    fi
fi
name="${connection:-${iface:-offline}}"
rtt=""
if command -v ping >/dev/null 2>&1 && [[ -n "$iface" ]]; then
    rtt="$(ping -n -c 1 -W 1 1.1.1.1 2>/dev/null | sed -n 's/.*time[=<]\([0-9.]*\) ms.*/\1/p' | head -n 1)"
fi
printf 'network=%s|%s\nping=%s\n' "$name" "${addr:---}" "${rtt:-timeout}"
