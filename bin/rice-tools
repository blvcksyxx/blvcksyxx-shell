#!/usr/bin/env python3
"""rice-tools: the toolbox of blvcksyxx shell (SUPER + X): tasks, a note, a focus timer, a converter, the system
at a glance, a chat with a local AI model, your games and automatic text work. This is the part of it that
needs a program.

  rice-tools open | toggle | close [TAB]   show the toolbox (TAB: tasks|note|timer|convert|system|chat|games|auto)
  rice-tools state                         JSON: where the toolbox is and how it behaves (Settings > Desktop > Toolbox)
  rice-tools set side left|right | width 360..560 | dim on|off | outside on|off | remember on|off
                 | opacity 0.3..1 (how solid the sheet is) | blur on|off (only the sheet is blurred, not the screen behind it)
                 | tab TAB (the one it opens on) | tabs tasks,note,... (which ones, in this order)
  rice-tools files TEXT                    JSON: up to 8 files and folders in your home whose name has TEXT in it
                                           (the launcher, after a few letters). fd, else locate, else a short walk
  rice-tools rates                         JSON: currency rates (European Central Bank, through frankfurter.dev),
                                           fetched at most twice a day, kept in ~/.cache/rice/rates.json
  rice-tools ai state                      JSON: the chat's settings and the models Ollama has
  rice-tools ai set url URL | model NAME
  rice-tools ai ask                        one line of JSON on standard input: {"messages": [{"role", "content"}, ...]}
                                           add "rag": true to answer from your indexed notes; sources come first
                                           as {"sources": [{"name", "src"}]}, then {"t": "text"} ..., {"done": true}
  rice-tools ai auto summarize|translate-en|translate-ru|extract|tasks
                                           read text on standard input, answer as lines of JSON (like ask)
  rice-tools ai ocr IMAGE                  text from a picture (tesseract, English and Russian)
  rice-tools ai index [PATH ...]           (re)build the local index from your notes and documents
  rice-tools ai docs | forget             what is indexed, or forget it
  rice-tools ai set rag on|off             answer from the indexed files (Toolbox > Chat > Files)

The chat talks only to Ollama on this computer (http://localhost:11434 by default). There is no cloud or
OpenAI-compatible provider: nothing you write leaves the machine. The settings are kept in
~/.config/rice/ai.json, readable only by you.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CACHE = HOME + "/.cache/rice"
AI = DIR + "/ai.json"
RATES = CACHE + "/rates.json"
TABS = TABS_ALL = ("tasks", "note", "timer", "convert", "system", "chat", "games", "auto")
AI_DEFAULTS = {"provider": "ollama", "url": "http://localhost:11434", "model": "", "rag": True}


CONF = DIR + "/tools.json"
# side: the edge it comes from; dim: the screen behind it gets darker; outside: a click outside closes it;
# remember: it opens on the tab you left it on (else on "tab")
CONF_DEFAULTS = {"side": "right", "width": 440, "dim": True, "outside": True, "remember": True, "tab": "tasks", "tabs": list(TABS_ALL),
                 "opacity": 0.8, "blur": True, "island": False}


def conf_load():
    c = json.loads(json.dumps(CONF_DEFAULTS))
    try:
        j = json.load(open(CONF))
    except Exception:
        j = {}
    if j.get("side") in ("left", "right"):
        c["side"] = j["side"]
    try:
        c["width"] = int(max(360, min(560, float(j.get("width", c["width"])))))
    except (TypeError, ValueError):
        pass
    for k in ("dim", "outside", "remember", "blur", "island"):
        if isinstance(j.get(k), bool):
            c[k] = j[k]
    try:
        c["opacity"] = round(max(0.3, min(1.0, float(j.get("opacity", c["opacity"])))), 2)
    except (TypeError, ValueError):
        pass
    if isinstance(j.get("tabs"), list):
        t = [x for x in dict.fromkeys(j["tabs"]) if x in TABS_ALL]
        # a config from before 2.1 lists the six old tabs in their old order: the two new ones join them
        if t == ["tasks", "note", "timer", "convert", "system", "chat"]:
            t += ["games", "auto"]
        if t:
            c["tabs"] = t
    if j.get("tab") in c["tabs"]:
        c["tab"] = j["tab"]
    elif c["tab"] not in c["tabs"]:
        c["tab"] = c["tabs"][0]
    return c


def conf_save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = CONF + ".tmp"
    json.dump(c, open(tmp, "w"), indent=1)
    os.replace(tmp, CONF)


def conf_set(a):
    c = conf_load()
    k, v = (a + ["", ""])[:2]
    if k == "side" and v in ("left", "right"):
        c["side"] = v
    elif k == "width":
        try:
            c["width"] = int(max(360, min(560, float(v))))
        except ValueError:
            sys.exit("width: a number, 360 to 560")
    elif k in ("dim", "outside", "remember", "blur", "island") and v in ("on", "off", "true", "false", "1", "0"):
        c[k] = v in ("on", "true", "1")
    elif k == "opacity":
        try:
            c["opacity"] = round(max(0.3, min(1.0, float(v))), 2)
        except ValueError:
            sys.exit("opacity: a number, 0.3 to 1")
    elif k == "tab" and v in TABS_ALL:
        c["tab"] = v
    elif k == "tabs":
        t = [x for x in dict.fromkeys(x.strip() for x in v.split(",")) if x in TABS_ALL]
        if not t:
            sys.exit("tabs: at least one of " + ",".join(TABS_ALL))
        c["tabs"] = t
    else:
        sys.exit("usage: rice-tools set side left|right | width N | opacity 0.3..1 | dim|outside|remember|blur|island on|off | tab TAB | tabs a,b,c")
    conf_save(c)
    if k == "blur":
        blur_now(c["blur"])


def blur_now(on):
    """Hyprland: the blur behind the toolbox, right away (at start rice-desktop.lua reads tools.json and sets it)"""
    import shutil
    import subprocess
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"):
        lua = 'if RiceToolsBlur then RiceToolsBlur(%s) end' % ("true" if on else "false")
        try:
            subprocess.run(["hyprctl", "eval", lua], capture_output=True, timeout=5)
        except Exception:
            pass


def conf_state():
    c = conf_load()
    keys = "SUPER + X"
    try:
        for line in open(DIR + "/keys.conf"):
            if line.strip().startswith("tools="):
                keys = line.split("=", 1)[1].strip() or keys
    except OSError:
        pass
    c["keys"] = keys
    c["all"] = list(TABS_ALL)
    out(c)


def out(o):
    sys.stdout.write(json.dumps(o) + "\n")
    sys.stdout.flush()


# ---------------- currency ----------------
def rates():
    try:
        j = json.load(open(RATES))
        if time.time() - j.get("time", 0) < 12 * 3600 and j.get("rates"):
            return j
    except Exception:
        j = None
    for url in ("https://api.frankfurter.dev/v1/latest?base=EUR", "https://api.frankfurter.app/latest?from=EUR"):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "blvcksyxx-shell"})
            d = json.loads(urllib.request.urlopen(req, timeout=8).read().decode())
            r = {k.upper(): float(v) for k, v in (d.get("rates") or {}).items()}
            if r:
                r["EUR"] = 1.0
                new = {"time": time.time(), "date": d.get("date", ""), "rates": r}
                os.makedirs(CACHE, exist_ok=True)
                tmp = RATES + ".tmp"
                json.dump(new, open(tmp, "w"))
                os.replace(tmp, RATES)
                return new
        except Exception:
            continue
    return j or {"time": 0, "date": "", "rates": {}}      # offline: the last ones we had


# ---------------- the chat ----------------
def local_url(u):
    """only this computer: Ollama on loopback. A cloud address is never used, even if an old file has one."""
    if not url_ok(u):
        return False
    try:
        h = urllib.parse.urlparse(u).hostname or ""
    except ValueError:
        return False
    return h in ("localhost", "127.0.0.1", "::1", "[::1]")


def ai_load():
    c = dict(AI_DEFAULTS)
    try:
        j = json.load(open(AI))
        # an old cloud provider, a cloud address or a key is dropped, and the file is rewritten without them
        cloud = j.get("provider") not in (None, "ollama") or (j.get("url") and not local_url(j.get("url")))
        if isinstance(j.get("model"), str) and not cloud:
            c["model"] = j["model"]
        if isinstance(j.get("rag"), bool):
            c["rag"] = j["rag"]
        if local_url(j.get("url")):
            c["url"] = j["url"].rstrip("/")
        if j.get("key") or cloud:
            ai_save(c)
    except Exception:
        pass
    return c


def ai_save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = AI + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(c, f, indent=1)
    os.replace(tmp, AI)
    os.chmod(AI, 0o600)


def url_ok(u):
    return isinstance(u, str) and (u.startswith("http://") or u.startswith("https://")) and len(u) < 300 and "\n" not in u


def ollama_models(c):
    try:
        d = json.loads(urllib.request.urlopen(c["url"].rstrip("/") + "/api/tags", timeout=2).read().decode())
        return [m["name"] for m in d.get("models", []) if isinstance(m.get("name"), str)]
    except Exception:
        return None


def ai_state():
    c = ai_load()
    models = ollama_models(c)
    d = ai_docs()
    out({"provider": "ollama", "url": c["url"], "model": c["model"], "has_key": False,
         "models": models or [], "reachable": models is not None, "rag": c.get("rag", True),
         "docs": {"indexed": d["indexed"], "files": d["files"], "chunks": d["chunks"], "when": d["when"]}})


def ai_set(a):
    c = ai_load()
    k = a[0] if a else ""
    if k == "url" and len(a) > 1 and local_url(a[1]):
        c["url"] = a[1].rstrip("/")
    elif k == "model" and len(a) > 1:
        c["model"] = a[1].strip()[:120]
    elif k == "rag" and len(a) > 1 and a[1] in ("on", "off"):
        c["rag"] = a[1] == "on"
    else:
        sys.exit("usage: rice-tools ai set url http://localhost:11434 | model NAME | rag on|off (local Ollama only)")
    ai_save(c)


# ---------------- local files for the chat (RAG): nothing leaves the computer ----------------
AI_INDEX = CACHE + "/ai-index.json"
DOC_EXT = (".md", ".markdown", ".txt", ".org", ".rst", ".log", ".json", ".csv", ".html", ".htm", ".pdf")
SKIP_DIRS = {".git", "node_modules", ".cache", ".local", ".config", "__pycache__", ".venv", "venv",
             ".mozilla", ".steam", ".wine", "Steam", ".var", ".cargo", ".rustup", ".npm", ".config"}


def ai_sources():
    src = [DIR + "/note.txt", DIR + "/todo.json"]
    for d in ("Documents", "Notes", "Desktop", "Downloads"):
        p = HOME + "/" + d
        if os.path.isdir(p):
            src.append(p)
    return src


def doc_text(path):
    if path.lower().endswith(".pdf"):
        if not shutil.which("pdftotext"):
            return ""
        try:
            return subprocess.run(["pdftotext", "-q", path, "-"], capture_output=True, text=True,
                                  timeout=25).stdout[:2000000]
        except Exception:
            return ""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read(2000000)
    except OSError:
        return ""


def doc_files(paths):
    files = []
    for raw in paths:
        p = os.path.expanduser(raw)
        if os.path.isfile(p):
            files.append(p)
        elif os.path.isdir(p):
            for dp, dn, fn in os.walk(p):
                dn[:] = [d for d in dn if d not in SKIP_DIRS and not d.startswith(".")]
                for f in fn:
                    if f.startswith(".") or not f.lower().endswith(DOC_EXT):
                        continue
                    fp = os.path.join(dp, f)
                    try:
                        if os.path.getsize(fp) <= 2000000:
                            files.append(fp)
                    except OSError:
                        pass
                if len(files) >= 500:
                    break
        if len(files) >= 500:
            break
    return list(dict.fromkeys(files))[:500]


def chunks_of(text):
    text = re.sub(r"\r\n?", "\n", text)
    text = re.sub(r"\n{3,}", "\n\n", text).strip()
    if not text:
        return []
    out, start = [], 0
    while start < len(text):
        end = min(len(text), start + 1100)
        if end < len(text):
            cut = text.rfind("\n", start + 600, end)
            if cut < 0:
                cut = text.rfind(" ", start + 700, end)
            if cut > start:
                end = cut
        part = text[start:end].strip()
        if part:
            out.append(part)
        if end >= len(text):
            break
        start = max(end - 150, start + 1)
    return out


def ai_index(paths):
    files = doc_files(paths or ai_sources())
    chunks, used = [], 0
    for p in files:
        text = doc_text(p)
        cs = chunks_of(text)
        if cs:
            used += 1
            for c in cs:
                chunks.append({"src": p.replace(HOME, "~", 1), "text": c})
        if len(chunks) >= 6000:
            break
    os.makedirs(CACHE, exist_ok=True)
    tmp = AI_INDEX + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"when": time.time(), "files": used, "chunks": chunks}, f, ensure_ascii=False)
    os.chmod(tmp, 0o600)
    os.replace(tmp, AI_INDEX)
    return {"ok": True, "files": used, "chunks": len(chunks), "when": time.time()}


def ai_index_load():
    try:
        j = json.load(open(AI_INDEX))
        if isinstance(j.get("chunks"), list):
            return j
    except Exception:
        pass
    return {"when": 0, "files": 0, "chunks": []}


def ai_docs():
    j = ai_index_load()
    return {"indexed": bool(j["chunks"]), "files": j.get("files", 0), "chunks": len(j.get("chunks", [])),
            "when": j.get("when", 0), "sources": ai_sources()}


def ai_tokens(t):
    return re.findall(r"[0-9a-zа-яё]{3,}", t.lower())


def ai_search(q, k=4):
    j = ai_index_load()
    terms = list(dict.fromkeys(ai_tokens(q)))[:24]
    if not terms or not j["chunks"]:
        return []
    scored = []
    for c in j["chunks"]:
        low = c["text"].lower()
        score = 0
        for t in terms:
            score += low.count(t)
        if not score:
            continue
        name = os.path.basename(c["src"]).lower()
        score += sum(3 for t in terms if t in name)
        # shorter pieces win when the score is the same
        scored.append((score / (1 + len(c["text"]) / 4000.0), c))
    scored.sort(key=lambda x: x[0], reverse=True)
    return [{"src": c["src"], "text": c["text"]} for _, c in scored[:k]]


def ai_context(q):
    hits = ai_search(q)
    if not hits:
        return "", []
    srcs = list(dict.fromkeys(h["src"] for h in hits))
    parts = []
    size = 0
    for h in hits:
        p = "[%s]\n%s" % (h["src"], h["text"])
        if size + len(p) > 7000:
            break
        parts.append(p)
        size += len(p)
    return "\n\n".join(parts), srcs


def ai_stream(c, msgs):
    base = c["url"].rstrip("/")
    model = c["model"]
    if not model:
        have = ollama_models(c)
        if have is None:
            return out({"err": "Ollama does not answer at " + base + ". Start it (ollama serve), or set another local address"})
        if not have:
            return out({"err": "Ollama has no model yet. Get one first: ollama pull llama3.2"})
        model = have[0]
    url, body, head = base + "/api/chat", {"model": model, "messages": msgs, "stream": True}, {}
    head.update({"Content-Type": "application/json", "User-Agent": "blvcksyxx-shell"})
    try:
        r = urllib.request.urlopen(urllib.request.Request(url, data=json.dumps(body).encode(), headers=head), timeout=120)
        for raw in r:
            line = raw.decode("utf-8", "replace").strip()
            if not line:
                continue
            j = json.loads(line)
            if j.get("error"):
                return out({"err": str(j["error"])[:300]})
            t = (j.get("message") or {}).get("content", "")
            if t:
                out({"t": t})
        out({"done": True})
    except urllib.error.HTTPError as e:
        try:
            msg = e.read().decode("utf-8", "replace")[:300]
        except Exception:
            msg = ""
        out({"err": "The service answered %d. %s" % (e.code, msg)})
    except Exception:
        out({"err": "Ollama does not answer at " + base + " (ollama serve starts it)"})


def ai_ask():
    c = ai_load()
    try:
        req = json.loads(sys.stdin.readline())
        msgs = [{"role": m["role"], "content": str(m["content"])[:20000]} for m in req.get("messages", [])
                if m.get("role") in ("system", "user", "assistant")][-40:]
        rag = req.get("rag") is True
    except Exception:
        return out({"err": "bad request"})
    if not msgs or not local_url(c["url"]):
        return out({"err": "The address of the model is not set"})
    if rag:
        q = next((m["content"] for m in reversed(msgs) if m["role"] == "user"), "")
        ctx, srcs = ai_context(q)
        if ctx:
            out({"sources": [{"name": os.path.basename(s), "src": s} for s in srcs]})
            msgs = [{"role": "system", "content":
                     "You answer from the notes below, which are on this computer. Use them when they fit; "
                     "if they do not contain the answer, say that plainly and answer from general knowledge only "
                     "when it is clearly useful. Do not invent sources.\n\n" + ctx}] + msgs
        else:
            out({"sources": []})
    ai_stream(c, msgs)


AUTO_PROMPTS = {
    "summarize": "Summarize the text in the language it is written in. Short: 3 to 6 bullets, then one line if it matters. No preamble.",
    "translate-en": "Translate the text into English. Give only the translation, keep the formatting.",
    "translate-ru": "Translate the text into Russian. Give only the translation, keep the formatting.",
    "extract": "Extract the important parts of the text: names, dates, numbers, decisions and open questions. Short bullets. Answer in the language of the text.",
    "tasks": "Turn the text into a short checklist of concrete tasks. One line per task, no preamble. Answer in the language of the text.",
}


def ai_auto(mode):
    text = sys.stdin.read(60000).strip()
    if not text:
        return out({"err": "There is no text: paste it or copy it first"})
    if mode not in AUTO_PROMPTS:
        return out({"err": "usage: rice-tools ai auto summarize|translate-en|translate-ru|extract|tasks"})
    c = ai_load()
    if not local_url(c["url"]):
        return out({"err": "The address of the model is not set"})
    ai_stream(c, [{"role": "system", "content": AUTO_PROMPTS[mode]},
                  {"role": "user", "content": text[:20000]}])


def ai_ocr(path):
    if not os.path.isfile(path):
        return out({"err": "No such picture: " + path})
    if not shutil.which("tesseract"):
        return out({"err": "tesseract is not installed: install tesseract and tesseract-data-rus"})
    try:
        r = subprocess.run(["tesseract", path, "stdout", "-l", "eng+rus"], capture_output=True, text=True, timeout=90)
        txt = (r.stdout or "").strip()
        if txt:
            out({"t": txt})
        else:
            out({"err": (r.stderr or "No text found in the picture").strip()[:300]})
    except Exception as e:
        out({"err": str(e)[:300]})


# ---------------- files for the launcher ----------------
SKIP = {".cache", ".local", ".git", "node_modules", ".var", ".cargo", ".rustup", ".npm", ".mozilla", "__pycache__",
        ".steam", "Steam", ".wine", ".config"}


def files(q):
    import shutil
    import subprocess
    q = q.strip()
    if len(q) < 2 or len(q) > 100:
        return out([])
    found = []
    fd = shutil.which("fd") or shutil.which("fdfind")
    try:
        if fd:
            r = subprocess.run([fd, "-i", "-F", "--max-results", "40", "--exclude", ".cache", "--exclude", "node_modules",
                                "--exclude", ".git", "--", q, HOME], capture_output=True, text=True, timeout=2)
            found = [x.rstrip("/") for x in r.stdout.splitlines() if x]
        elif shutil.which("plocate") or shutil.which("locate"):
            r = subprocess.run([shutil.which("plocate") or shutil.which("locate"), "-i", "-l", "200", "-b", q],
                               capture_output=True, text=True, timeout=2)
            found = [x for x in r.stdout.splitlines() if x.startswith(HOME + "/") and "/." not in x[len(HOME):]]
    except Exception:
        found = []
    if not found:
        ql, end = q.lower(), time.time() + 0.7
        for root, dirs, fs in os.walk(HOME):
            dirs[:] = [d for d in dirs if not d.startswith(".") and d not in SKIP]
            if root[len(HOME):].count("/") >= 6:
                dirs[:] = []
            for n in dirs + fs:
                if ql in n.lower():
                    found.append(os.path.join(root, n))
            if len(found) >= 40 or time.time() > end:
                break
    ql = q.lower()

    def rank(p):
        n = os.path.basename(p).lower()
        return (0 if n == ql else 1 if n.startswith(ql) else 2, p.count("/"), len(n))
    res = []
    for p in sorted(set(found), key=rank)[:8]:
        res.append({"path": p, "name": os.path.basename(p), "dir": os.path.isdir(p),
                    "where": os.path.dirname(p).replace(HOME, "~", 1)})
    out(res)


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    if cmd in ("open", "toggle", "close"):
        tab = a[2] if len(a) > 2 and a[2] in TABS else "-"
        os.makedirs(CACHE, exist_ok=True)
        with open(CACHE + "/tools-open", "w") as f:
            f.write("%.3f %s %s\n" % (time.time(), cmd, tab))
    elif cmd == "state":
        conf_state()
    elif cmd == "set":
        conf_set(a[2:])
    elif cmd == "rates":
        out(rates())
    elif cmd == "files":
        files(" ".join(a[2:]))
    elif cmd == "ai" and len(a) > 2 and a[2] == "state":
        ai_state()
    elif cmd == "ai" and len(a) > 2 and a[2] == "set":
        ai_set(a[3:])
    elif cmd == "ai" and len(a) > 2 and a[2] == "ask":
        ai_ask()
    elif cmd == "ai" and len(a) > 2 and a[2] == "auto":
        ai_auto(a[3] if len(a) > 3 else "")
    elif cmd == "ai" and len(a) > 2 and a[2] == "ocr":
        ai_ocr(a[3] if len(a) > 3 else "")
    elif cmd == "ai" and len(a) > 2 and a[2] == "index":
        out(ai_index(a[3:]))
    elif cmd == "ai" and len(a) > 2 and a[2] == "docs":
        out(ai_docs())
    elif cmd == "ai" and len(a) > 2 and a[2] == "forget":
        try:
            os.remove(AI_INDEX)
        except OSError:
            pass
        out({"ok": True, "indexed": False, "files": 0, "chunks": 0, "when": 0})
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
