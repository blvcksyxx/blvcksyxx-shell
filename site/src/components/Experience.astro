---
import Logo from './Logo.astro';

const principles = [
  {
    num: '01',
    title: 'one language, not a pile of tools.',
    body: 'The bar, island, control center, launcher, notifications, dashboard, dock and lock screen share one geometry, one type scale and one motion language. Nothing feels bolted on.',
  },
  {
    num: '02',
    title: 'everyday things, one gesture away.',
    body: 'Settings with SUPER + U. The launcher with ALT + Space. The control center with SUPER + N. Widgets with SUPER + ALT + W. The shell is designed around the keys your hands already know.',
  },
  {
    num: '03',
    title: 'detail is part of the function.',
    body: 'Material 3 motion, wavy progress lines, interface sounds and soft shapes are not decoration. They are feedback — the difference between a click and a response.',
  },
  {
    num: '04',
    title: 'personal by default.',
    body: 'Twenty-one color schemes, six of them monochrome. Fonts, shapes, bar layouts, dock edges, launcher layouts and eight sound packs. It becomes yours without opening a config file.',
  },
  {
    num: '05',
    title: 'linux, treated as a first-class desktop.',
    body: 'Real Quickshell QML, running on Hyprland 0.55+ and niri 25.05+. Distro logos picked automatically, a real installer, real backups. No emulation and no invented compatibility.',
  },
] as const;

const stats = [
  { value: '21', label: 'color schemes' },
  { value: '08', label: 'sound packs' },
  { value: '10', label: 'notification sounds' },
  { value: '05', label: 'launcher themes' },
] as const;
---

<section class="section experience" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>
        <span class="dot" aria-hidden="true"></span>
        philosophy
        <span class="slash" aria-hidden="true">/</span>
        why it feels different
      </p>
      <div class="head-copy">
        <h2 id="experience-title" data-reveal>the desktop should<br />disappear into the work.</h2>
      </div>
      <div class="head-side">
        <p class="lede" data-reveal>
          blvcksyxx shell starts from a simple idea: the desktop is not a pile of widgets. It is the
          space between you and what you are doing. Every part exists to shorten that distance.
        </p>
      </div>
    </div>

    <div class="experience-body">
      <div class="experience-visual" data-reveal aria-hidden="true">
        <div class="orbit">
          <div class="orbit-ring orbit-ring-a"><i class="orbit-node"></i></div>
          <div class="orbit-ring orbit-ring-b"></div>
          <div class="orbit-ring orbit-ring-c"></div>
          <div class="orbit-core">
            <Logo class="orbit-mark" />
            <span>blvcksyxx shell</span>
            <em>one surface</em>
          </div>
          <span class="orbit-label o-1">bar</span>
          <span class="orbit-label o-2">island</span>
          <span class="orbit-label o-3">control center</span>
          <span class="orbit-label o-4">launcher</span>
          <span class="orbit-label o-5">widgets</span>
          <span class="orbit-label o-6">lock screen</span>
        </div>
        <div class="orbit-meta mono">
          <span><i></i> seven surfaces</span>
          <span>quickshell qml</span>
        </div>
      </div>

      <ol class="principles">
        {principles.map((item) => (
          <li class="principle">
            <span class="principle-num mono">{item.num}</span>
            <div class="principle-copy">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="experience-stats">
      {stats.map((stat) => (
        <div class="exp-stat">
          <span class="exp-stat-value">{stat.value}</span>
          <span class="exp-stat-label mono">{stat.label}</span>
        </div>
      ))}
      <div class="exp-stat exp-stat-note">
        <span class="exp-stat-label mono">everything is set with sliders and switches</span>
        <span class="exp-stat-value exp-stat-value-sm">no config editing.</span>
      </div>
    </div>
  </div>
</section>
