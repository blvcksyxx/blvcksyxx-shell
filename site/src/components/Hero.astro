---
import {
  ArrowDown,
  BatteryFull,
  BellOff,
  Bluetooth,
  Coffee,
  Folder,
  Globe,
  LayoutGrid,
  MoonStar,
  AudioLines,
  Pause,
  Plane,
  Play,
  Send,
  Settings,
  Rewind,
  FastForward,
  Sun,
  Terminal,
  Volume2,
  Wifi,
} from '@lucide/astro';
import { site } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-copy">
      <span class="hero-badge intro">
        <span class="pulse" aria-hidden="true"></span>
        LINUX DESKTOP EXPERIENCE
        <span class="hero-badge-ver">{site.version}</span>
      </span>

      <h1 class="hero-title" id="hero-title">
        <span class="line intro">your desktop.</span>
        <span class="line line-2 intro">your rules.</span>
      </h1>

      <p class="hero-lede intro">
        A complete Linux desktop shell for Hyprland and niri. Task view, Alt + Tab, the bar and
        dynamic island, control center, widgets, launcher, dock and lock screen — one coherent
        system, tuned to your taste.
      </p>
      <div class="hero-actions intro">
        <a class="btn btn-primary" href="#interface">
          explore the shell
          <ArrowDown size={16} stroke-width={1.8} />
        </a>
        <a class="btn btn-ghost" href={site.telegram} target="_blank" rel="noopener noreferrer">
          <Send size={15} stroke-width={1.7} />
          join telegram
        </a>
      </div>

      <div class="hero-meta intro">
        <span>Hyprland 0.55+ / niri 25.05+</span>
        <span class="sep" aria-hidden="true"></span>
        <span>Quickshell · QML</span>
        <span class="sep" aria-hidden="true"></span>
        <span>MIT licensed</span>
      </div>
    </div>

    <div class="hero-visual-wrap">
      <div class="hero-visual-glow" aria-hidden="true" data-parallax-glow></div>
      <span class="hero-tag is-top" aria-hidden="true">dynamic island / live</span>
      <span class="hero-tag is-bottom" aria-hidden="true">control center / quick</span>

      <div class="hero-screen" data-parallax-screen>
        <div
          class="desktop desktop--hero"
          role="img"
          aria-label="Interface illustration of blvcksyxx shell: a monochrome desktop with the dynamic island, an expanded music player, a clock widget, system rings, an open control center and a dock."
        >
          <div class="desktop-wallpaper">
            <picture>
              <source
                type="image/webp"
                srcset="/wallpapers/mono-peaks-800.webp 800w, /wallpapers/mono-peaks-1600.webp 1600w"
                sizes="(max-width: 720px) 100vw, 1280px"
              />
              <img
                src="/wallpapers/mono-peaks-1600.jpg"
                alt=""
                width="1600"
                height="900"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>

          <div class="desktop-bar">
            <div class="bar-group">
              <span class="bar-launcher"><LayoutGrid size={12} stroke-width={2} /></span>
              <span class="workspace-dots" aria-hidden="true">
                <i class="is-on"></i><i></i><i></i><i></i><i></i>
              </span>
              <span class="bar-title">kitty — ~/dotfiles</span>
            </div>
            <div class="bar-group bar-status">
              <Wifi size={12} stroke-width={1.8} />
              <Volume2 size={12} stroke-width={1.8} />
              <span class="battery"><BatteryFull size={11} stroke-width={1.8} /> 84</span>
            </div>
          </div>

          <div class="island">
            <span class="island-time">09:41</span>
            <span class="island-weather"><Sun size={11} stroke-width={1.8} /> 14°</span>
            <span class="island-music-dot" aria-hidden="true"></span>
            <span class="wavebars" aria-hidden="true">
              <i></i><i></i><i></i><i></i><i></i>
            </span>
            <span class="island-notif-dot" aria-hidden="true"></span>
          </div>

          <div class="island-player">
            <div class="album-art"><AudioLines size={16} stroke-width={1.5} /></div>
            <div class="player-copy">
              <p class="player-title">night drive</p>
              <p class="player-sub">ambient sessions · 02:14</p>
              <div class="player-progress">
                <span class="player-track"><i></i></span>
                <span class="player-time">2:14 / 5:48</span>
              </div>
            </div>
            <div class="player-controls">
              <Rewind size={12} stroke-width={1.8} />
              <span class="is-play"><Pause size={10} stroke-width={2} /></span>
              <FastForward size={12} stroke-width={1.8} />
              <span class="wavebars" aria-hidden="true">
                <i></i><i></i><i></i><i></i><i></i>
              </span>
            </div>
          </div>

          <div class="desktop-widget widget-clock">
            <p class="widget-kicker">local time</p>
            <p class="widget-time">09:41</p>
            <p class="widget-date">thursday, 12 november</p>
          </div>

          <div class="desktop-widget widget-rings">
            <div class="rings" aria-hidden="true"><span class="ring"></span></div>
            <div class="rings-copy">
              <span>CPU 38%</span>
              <span>RAM 62%</span>
              <span>GPU 21%</span>
            </div>
          </div>

          <div class="cc-panel">
            <div class="cc-head">
              <span class="cc-title">Control center</span>
              <span class="cc-tabs"><span class="on">quick</span><span>alerts</span></span>
            </div>
            <div class="cc-sliders">
              <div class="cc-slider">
                <Volume2 size={12} stroke-width={1.8} />
                <span class="cc-track"><i style="width: 64%"></i></span>
                <span class="cc-slider-val">64%</span>
              </div>
              <div class="cc-slider">
                <Sun size={12} stroke-width={1.8} />
                <span class="cc-track"><i style="width: 82%"></i></span>
                <span class="cc-slider-val">82%</span>
              </div>
            </div>
            <div class="cc-grid">
              <span class="cc-toggle is-on"><Wifi size={12} stroke-width={1.8} /><span>Wi-Fi</span></span>
              <span class="cc-toggle is-on"><Bluetooth size={12} stroke-width={1.8} /><span>Bluetooth</span></span>
              <span class="cc-toggle"><MoonStar size={12} stroke-width={1.8} /><span>Night light</span></span>
              <span class="cc-toggle"><Plane size={12} stroke-width={1.8} /><span>Airplane</span></span>
              <span class="cc-toggle"><Coffee size={12} stroke-width={1.8} /><span>Keep awake</span></span>
              <span class="cc-toggle"><BellOff size={12} stroke-width={1.8} /><span>Do not disturb</span></span>
            </div>
            <div class="cc-net">
              <span class="cc-net-label">NETWORK</span>
              <span class="cc-net-row"><span>home-5g</span><strong>connected</strong></span>
              <span class="cc-net-row"><span>PING</span><strong>12 ms</strong></span>
            </div>
            <div class="cc-media">
              <span class="album-art"><AudioLines size={11} stroke-width={1.6} /></span>
              <span class="cc-media-copy">
                <span class="cc-media-title">night drive</span>
                <span class="cc-media-sub">ambient sessions</span>
              </span>
              <Rewind size={11} stroke-width={1.8} />
              <Play size={11} stroke-width={1.8} />
              <FastForward size={11} stroke-width={1.8} />
            </div>
          </div>

          <div class="dock">
            <span class="dock-app is-active"><Terminal size={17} stroke-width={1.6} /></span>
            <span class="dock-app"><Folder size={17} stroke-width={1.6} /></span>
            <span class="dock-app"><Globe size={17} stroke-width={1.6} /></span>
            <span class="dock-app"><AudioLines size={17} stroke-width={1.6} /></span>
            <span class="dock-app"><Settings size={17} stroke-width={1.6} /></span>
          </div>
        </div>
      </div>

      <div class="hero-caption" aria-hidden="true">
        <span>the shell, in motion</span>
        <span>dynamic bar · control center · widgets · dock</span>
      </div>
    </div>

    <p class="hero-scroll">scroll to explore</p>
  </div>
</section>
